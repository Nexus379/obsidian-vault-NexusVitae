filters:
  and:
    - arch.contains("#6resource")
    - archtype.contains("#6resource/film")
views:
  - type: table
    name: 🎬 Films
    order:
      - cover
      - file.name
      - creator
      - plattform
      - status
      - rating
      - ranking
      - file.path
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      cover: 90
      file.name: 240
      note.creator: 160
      note.plattform: 120
      note.status: 90
  - type: table
    name: ⚡ Active
    filters:
      or:
        - status == "1active"
        - status == "0start"
    order:
      - file.name
      - creator
      - plattform
      - rating
      - ranking
    sort:
      - property: file.mtime
        direction: DESC
