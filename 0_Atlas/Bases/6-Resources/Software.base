filters:
  and:
    - arch.contains("#6resource")
    - archtype.contains("#6resource/software")
views:
  - type: table
    name: 💽 Software
    order:
      - file.name
      - software_type
      - maintenance_status
      - version
      - rating
      - ranking
      - vendor
      - plattform
      - url
      - last_checked
      - next_check
      - file.path
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 240
      note.software_type: 120
      note.maintenance_status: 140
      note.version: 100
      note.vendor: 140
      note.plattform: 140
  - type: table
    name: ⚡ Active
    filters:
      or:
        - status == "1active"
        - status == "0start"
    order:
      - file.name
      - software_type
      - maintenance_status
      - version
      - rating
      - ranking
      - next_check
    sort:
      - property: file.mtime
        direction: DESC
