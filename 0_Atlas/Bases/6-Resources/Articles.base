filters:
  and:
    - arch.contains("#6resource")
    - archtype.contains("#6resource/article")
views:
  - type: table
    name: 🗞️ Articles
    order:
      - cover
      - file.name
      - creator
      - status
      - rating
      - ranking
      - url
      - discipline
      - science
      - file.path
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      cover: 90
      file.name: 240
      note.creator: 160
      note.status: 90
      note.rating: 80
  - type: table
    name: ⚡ Active
    filters:
      or:
        - status == "1active"
        - status == "0start"
    order:
      - file.name
      - creator
      - rating
      - ranking
      - url
    sort:
      - property: file.mtime
        direction: DESC
