filters:
  and:
    - arch.contains("#6resource")
    - archtype.contains("#6resource/recipe")
views:
  - type: table
    name: 🍰 Recipes
    order:
      - cover
      - file.name
      - status
      - rating
      - area2
      - file.path
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      cover: 90
      file.name: 240
      note.status: 90
      note.rating: 80
  - type: table
    name: ⚡ Active
    filters:
      or:
        - status == "1active"
        - status == "0start"
    order:
      - file.name
      - area2
      - rating
    sort:
      - property: file.mtime
        direction: DESC
